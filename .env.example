# enviaronment
WEB_ENV={{ dev | test | uat | prod }} # (In use "dev")

# server env
REDIS_HOST={{REDIS_HOST}}
REDIS_PORT={{REDIS_PORT}}
REDIS_SSL={{ ON | OFF}}
REDIS_USER={{REDIS_USER}}
REDIS_PASSWORD={{REDIS_PASSWORD}}
REDIX_PREFIX={{REDIX_PREFIX}}
WEB_URL={{WEB_HOST_NAME}} # (In use "http://localhost:3000")
HANDLE_REFRESH={{ ON | OFF}} # (In use "OFF")
BACK_URL={{BACK_HOST_NAME}}
ALLOW_ORIGIN={{PAGE_ALLOW_ORIGIN}}
LOG_FILE={{ ON | OFF}}
MAX_FIES={{MAX_DAYS_LOG_FILE}}
WEB_JWE_PRIVATE_KEY="{{WEB_JWE_PRIVATE_KEY}}"
WEB_JWE_PUBLIC_KEY="{{WEB_JWE_PUBLIC_KEY}}"
WEB_JWS_PRIVATE_KEY="{{WEB_JWS_PRIVATE_KEY}}"
WEB_JWS_PUBLIC_KEY="{{WEB_JWS_PUBLIC_KEY}}"
BACK_JWE_PUBLIC_KEY="{{BACK_JWE_PUBLIC_KEY}}"
BACK_JWE_PRIVATE_KEY="{{BACK_JWE_PRIVATE_KEY}}"
BACK_JWS_PRIVATE_KEY="{{BACK_JWS_PRIVATE_KEY}}"

# client env
NEXT_PUBLIC_WEB_ENV=${WEB_ENV}
NEXT_PUBLIC_WEB_URL=${WEB_URL}
NEXT_PUBLIC_HANDLE_REFRESH=${HANDLE_REFRESH}
NEXT_PUBLIC_WEB_JWE_PUBLIC_KEY=${WEB_JWE_PUBLIC_KEY}
NEXT_PUBLIC_WEB_JWS_PUBLIC_KEY=${WEB_JWS_PUBLIC_KEY}
