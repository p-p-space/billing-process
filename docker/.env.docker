# enviaronment
WEB_ENV=local
APP_EXP_PORT=30000

# server env only for local settings
WEB_URL=https://billing.docker
SERV_URL=https://t-api.novopayment.com
TIMEZONE=America/Caracas # Can be America/Caracas, America/Bogota, America/Miami, America/Lima etc.

# Cookie env only for local settings
# COOKIE_EXPIRES=120

# Redis env only for local settings
REDIS_HOST=redis-web
REDIS_PORT=6379
REDIS_DB=0
REDIS_SSL=OFF
REDIS_USER=''
REDIS_PASSWORD=123456 # your local redis password

# session env only for local settings
# SESS_EXP_TIME=60
SESS_MATCH_IP=OFF
SESS_REFRESH=OFF

# public env
NEXT_PUBLIC_WEB_URL=${WEB_URL}

